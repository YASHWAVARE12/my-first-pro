num = int(input("enter the number you want to cheak : "))

i = 1 
is_perfect_square = False

while i *i <=  num:
    if i*i == num:
        is_perfect_square = True
        break

    i +=1

if is_perfect_square:
    print("given {num} is perfect square")

else:
    print("given {num} is not perfect number")
    





